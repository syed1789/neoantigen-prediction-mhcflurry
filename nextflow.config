// nextflow.config
// Run locally with Docker by default: nextflow run neoantigen.nf -profile docker

manifest {
    name            = 'neoantigen-prediction-mhcflurry'
    description     = 'Somatic VCF -> candidate peptides -> MHCflurry MHC-I binding prediction -> ranked neoantigen candidates'
    author          = 'Syed Nurul Hasan'
    nextflowVersion = '>=23.10.0'
}

params {
    outdir = "${projectDir}/results"
}

process {
    cpus   = 2
    memory = '4 GB'
    time   = '1h'
}

profiles {
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Runs bin/*.py directly against whatever `python3` is on PATH instead of
    // pulling containers. This is what was actually used to validate this
    // pipeline end-to-end in the environment it was built in (no local Docker
    // daemon available there — see NEOANTIGEN.md). Requires the packages in
    // requirements.txt to be installed (a venv is the easy way: see README).
    local {
        process.executor = 'local'
    }

    // Example HPC/Slurm profile — adjust queue/account for a real cluster
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'general'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Example cloud profile (AWS Batch) — fill in your own bucket/queue
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = 'my-batch-queue'
        workDir           = 's3://my-bucket/work'
        aws.region        = 'us-east-1'
    }
}

// PREDICT_BINDING downloads/loads the MHCflurry model weights (~160MB) and
// runs a neural net forward pass per peptide/allele pair — the heaviest step.
process {
    withName: PREDICT_BINDING {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
    }
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

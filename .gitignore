# Nextflow work/cache directories
work/
.nextflow/
.nextflow.log*

# Pipeline outputs (regenerated by running the pipeline; example_results/ is
# the one committed, curated snapshot of real output -- see README)
results/

# Python virtual environment
.venv/
__pycache__/
*.pyc

# MHCflurry downloaded model weights are cached under the OS app-support
# dir (~/Library/Application Support/mhcflurry or $MHCFLURRY_DATA_DIR), not
# inside this repo -- nothing to ignore here, noted for clarity.

# Environment / secrets / local overrides
.env
*.env
.envrc
*secrets*

# OS cruft
.DS_Store

# Editors
.vscode/
.idea/
